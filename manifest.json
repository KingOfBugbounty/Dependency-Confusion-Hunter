{
  "manifest_version": 3,
  "name": "Dependency Confusion Hunter",
  "version": "1.4.0",
  "description": "Advanced passive scanner for dependency confusion vulnerabilities across npm, PyPI, RubyGems, Go, Cargo, Composer - by OFJAAAH",
  "author": "OFJAAAH",
  "permissions": [
    "storage",
    "webRequest",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "poc-workflow.html", "poc-workflow.js", "tutorials.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
